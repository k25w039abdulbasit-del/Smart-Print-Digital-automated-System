# Copy to .env (server machine). Every value is read with the SMARTPRINT_ prefix.
SMARTPRINT_ENVIRONMENT=prod                       # prod refuses to start with the dev secrets below
SMARTPRINT_DATABASE_URL=postgresql+psycopg://smartprint:CHANGE_ME@localhost:5432/smartprint
SMARTPRINT_DATA_DIR=./data                        # uploaded files (auto-deleted after use) + spool
SMARTPRINT_SECRET_KEY=                            # >= 32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SMARTPRINT_WEBHOOK_SECRET=                        # shared with the payment provider
SMARTPRINT_CURRENCY=PKR

# Printing: spool (dev/demo: writes PDFs to data/spool) | cups (Linux/macOS) | sumatra (Windows)
SMARTPRINT_PRINTER_BACKEND=sumatra
SMARTPRINT_DEFAULT_PRINTER=Shop-Printer
SMARTPRINT_SUMATRA_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe

SMARTPRINT_MAX_UPLOAD_MB=50
SMARTPRINT_MAX_PAGES=500
SMARTPRINT_PAYMENT_TTL_S=600                      # online payment request lifetime
SMARTPRINT_PRINT_LEASE_S=120                      # PRINTING without a result for this long -> UNCERTAIN (staff check)
SMARTPRINT_PRINT_MAX_ATTEMPTS=3
